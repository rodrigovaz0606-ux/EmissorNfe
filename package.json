{
  "name": "emissor-nfe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Emissor de NF-e modelo 55 direto na SEFAZ (Node). Fase 1: comunicação e status do serviço.",
  "scripts": {
    "status": "node scripts/status.js",
    "cert": "node scripts/cert-info.js",
    "test": "node --test server/ src/",
    "gerar": "node scripts/gerar.js",
    "validar": "node scripts/validar.js",
    "enviar": "node scripts/enviar.js",
    "dev": "concurrently -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "consultar": "node scripts/consultar.js",
    "e2e": "vite build && node e2e/interface.test.js"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "better-sqlite3": "^8.7.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "fast-xml-parser": "^5.10.1",
    "node-forge": "^1.3.1",
    "pdfkit": "^0.20.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xml-crypto": "^6.4.0",
    "xmllint-wasm": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "playwright-core": "^1.49.1",
    "vite": "^6.4.5"
  }
}
