{
  "name": "emissor-nfe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Emissor de NF-e modelo 55 direto na SEFAZ (homologação). Backend em Rust, interface em React.",
  "scripts": {
    "dev": "concurrently -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "cargo run -q --manifest-path backend/Cargo.toml -- servidor",
    "dev:web": "vite",
    "build": "vite build && cargo build --release --manifest-path backend/Cargo.toml",
    "start": "cargo run -q --release --manifest-path backend/Cargo.toml -- servidor",
    "test": "cargo test --manifest-path backend/Cargo.toml && node --test src/",
    "e2e": "vite build && cargo build --release --manifest-path backend/Cargo.toml && node e2e/interface.test.js",
    "status": "cargo run -q --manifest-path backend/Cargo.toml -- status",
    "cert": "cargo run -q --manifest-path backend/Cargo.toml -- cert",
    "gerar": "cargo run -q --manifest-path backend/Cargo.toml -- gerar",
    "validar": "cargo run -q --manifest-path backend/Cargo.toml -- validar",
    "enviar": "cargo run -q --manifest-path backend/Cargo.toml -- enviar",
    "consultar": "cargo run -q --manifest-path backend/Cargo.toml -- consultar"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "playwright-core": "^1.49.1",
    "vite": "^6.4.5"
  }
}
