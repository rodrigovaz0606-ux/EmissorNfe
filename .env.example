# Caminho para o certificado A1 (.pfx). Pode ser absoluto ou relativo à pasta do projeto.
CERT_PFX_PATH=C:/caminho/para/seu-certificado.pfx
CERT_PFX_SENHA=

# UF do emitente (por enquanto só GO está mapeada)
NFE_UF=GO

# homologacao (padrão, sem valor fiscal) ou producao (notas com VALOR FISCAL, banco data/producao.sqlite).
NFE_AMBIENTE=homologacao

# Mensalidade dos produtores por Pix, pelo GatewayRR. Desligada por padrão (false).
# Com true, todos os itens abaixo são obrigatórios, ou o sistema não sobe.
API_PAGAMENTO=false
# Só o endereço do gateway, com https:// (http:// só para localhost). Sem caminho.
URL_API_PAGAMENTO=
# Gere o par com `npm run pagamento-chave`: a chave pública vai para o operador do gateway,
# que devolve o ID. A privada fica só aqui (não mostre a ninguém).
PAGAMENTO_CHAVE_ID=
PAGAMENTO_CHAVE_PRIVADA=
# Valor da mensalidade por produtor, em reais (mínimo 5,00).
PAGAMENTO_VALOR_MENSAL=99,90

# Login único pelo SaintSSO. Desligado por padrão; ligue só com o SaintSSO no ar.
SSO_ENABLED=false
SSO_ISSUER=
SSO_CLIENT_ID=emissor-nfe-web
SSO_CLIENT_SECRET=

# Integração com o Campo Certo (pacote Pro): notas autorizadas e cancelamentos de produtor com CPF
# vão para o Campo Certo do mesmo servidor. Deixe vazio para desligar.
# O segredo (32+ caracteres) tem de ser o mesmo INTEGRACAO_EMISSOR_SEGREDO do Campo Certo.
CAMPO_CERTO_URL=
INTEGRACAO_EMISSOR_SEGREDO=
