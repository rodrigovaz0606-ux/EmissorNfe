# Caminho para o certificado A1 (.pfx). Pode ser absoluto ou relativo à pasta do projeto.
CERT_PFX_PATH=C:/caminho/para/seu-certificado.pfx
CERT_PFX_SENHA=

# UF do emitente (por enquanto só GO está mapeada)
NFE_UF=GO

# Só "homologacao" é aceito nesta fase. Produção está bloqueada no código.
NFE_AMBIENTE=homologacao
